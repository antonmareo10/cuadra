{
  "name": "cuadra",
  "version": "0.1.0",
  "private": true,
  "description": "Three-way match for small restaurants: purchase order, delivery note and supplier invoice, read and checked with the Clocked API.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "demo": "npm run build && npm run start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "documents": "tsx scripts/generate-documents.ts",
    "smoke": "tsx --env-file-if-exists=.env.local scripts/smoke.ts",
    "record": "tsx --env-file-if-exists=.env.local scripts/record.ts",
    "runs": "tsx scripts/build-runs.ts",
    "credits": "tsx scripts/credits.ts",
    "mcp": "tsx mcp/server.ts",
    "mcp:demo": "node scripts/mcp-demo.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "clsx": "2.1.1",
    "geist": "1.8.1",
    "lenis": "1.3.27",
    "motion": "14.4.0",
    "next": "16.4.2",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
